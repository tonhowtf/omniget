{
  "name": "omniget",
  "version": "1.0.0",
  "description": "Free desktop downloader for YouTube, Instagram, TikTok, X, Reddit, torrents and the sites yt-dlp supports, with an MCP server for Claude Code, Cursor and VS Code, a window for AI agents (Claude Code, Codex, Gemini CLI, Ollama), meeting notes that record, transcribe and summarize calls and import Teams recordings, and washmybelly to clean junk, uninstall apps and tune privacy and performance. Open source for Windows, macOS and Linux.",
  "keywords": [
    "downloader",
    "yt-dlp",
    "yt-dlp-gui",
    "youtube-downloader",
    "video-downloader",
    "instagram-downloader",
    "tiktok-downloader",
    "torrent",
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "ollama",
    "mcp-server",
    "agent-client-protocol",
    "coding-agent",
    "desktop-app",
    "system-cleaner",
    "uninstaller",
    "fps-counter",
    "meeting-notes",
    "microsoft-teams",
    "transcription",
    "tauri"
  ],
  "homepage": "https://getomniget.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonhowtf/omniget.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:appimage": "bash scripts/linux/appimage.sh",
    "version:set": "node scripts/bump-version.js",
    "generate:i18n-keys": "node scripts/generate-i18n-keys.js",
    "check:i18n": "node scripts/generate-i18n-keys.js --strict",
    "check:clippy-baseline": "node scripts/clippy-baseline.mjs --check",
    "update:clippy-baseline": "node scripts/clippy-baseline.mjs --update",
    "extension:sync": "node browser-extension/sync.mjs",
    "check:ipc": "node scripts/check-ipc.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:plugin": "python3 -m unittest discover -s claude-plugin/omniget/tests -p \"test_*.py\" && bash claude-plugin/omniget/tests/test_keys.sh && bash claude-plugin/omniget/tests/test_retry.sh",
    "canary": "node scripts/canary.mjs",
    "test": "vitest run",
    "test:fast": "node scripts/test-fast.mjs",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "node scripts/git-hooks/install.mjs",
    "hooks:uninstall": "node scripts/git-hooks/install.mjs --uninstall",
    "test:inventory": "node scripts/test-inventory.mjs",
    "test:watch": "vitest",
    "dev:app": "node scripts/dev/session.mjs start",
    "dev:status": "node scripts/dev/session.mjs status",
    "dev:doctor": "node scripts/dev/session.mjs doctor",
    "dev:revision": "node scripts/dev/session.mjs revision",
    "dev:wait": "node scripts/dev/session.mjs wait",
    "dev:capture": "node scripts/dev/session.mjs capture",
    "dev:stop": "node scripts/dev/session.mjs stop",
    "bench:prepare": "python3 scripts/llm/prepared.py",
    "bench:run": "python3 scripts/llm/bench.py",
    "test:dev": "node --test scripts/dev/contracts.test.mjs && python3 -m unittest discover -s scripts/llm -p test_prepared.py",
    "dev:prepare": "node scripts/dev/session.mjs prepare"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@pixiv/three-vrm": "3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bot-avatars": "^0.1.1",
    "dashjs": "^5.2.1",
    "camera-controls": "^3.1.2",
    "hls.js": "^1.7.3",
    "marked": "^14.1.3",
    "pdfjs-dist": "^6.3.289",
    "meshoptimizer": "1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sveltekit-i18n": "^2.4.2",
    "thinking-orbs": "^0.3.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "playwright": "^1.62.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
