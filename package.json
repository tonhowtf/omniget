{
  "name": "omniget",
  "version": "1.0.1",
  "description": "Desktop app with a local MCP server that gives coding agents (Claude Code, Codex, Gemini CLI, Cursor) a toolbox for downloads, media, files, chats and system cleanup, plus a downloader for YouTube, Instagram, TikTok, X, Reddit, torrents and the sites yt-dlp supports, and a Canvas for agent terminals. Open source for Windows, macOS and Linux.",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "downloader",
    "yt-dlp",
    "yt-dlp-gui",
    "youtube-downloader",
    "video-downloader",
    "instagram-downloader",
    "tiktok-downloader",
    "torrent",
    "desktop-app",
    "system-cleaner",
    "transcription",
    "tauri"
  ],
  "homepage": "https://getomniget.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonhowtf/omniget.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:appimage": "bash scripts/linux/appimage.sh",
    "version:set": "node scripts/bump-version.js",
    "release:local": "node scripts/release-local.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "check:i18n": "node scripts/check-i18n.js --strict",
    "check:clippy-baseline": "node scripts/clippy-baseline.mjs --check",
    "update:clippy-baseline": "node scripts/clippy-baseline.mjs --update",
    "extension:sync": "node browser-extension/sync.mjs",
    "extension:firefox": "node scripts/package-firefox-extension.mjs",
    "check:ipc": "node scripts/check-ipc.mjs",
    "check:dead": "pnpm dlx knip@6.44.1 --no-progress --include files,dependencies,unlisted,binaries",
    "gen:mcp-catalog": "node scripts/gen-mcp-catalog.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:plugin": "python3 -m unittest discover -s claude-plugin/omniget/tests -p \"test_*.py\"",
    "canary": "node scripts/canary.mjs",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "node scripts/git-hooks/install.mjs",
    "hooks:uninstall": "node scripts/git-hooks/install.mjs --uninstall",
    "test:watch": "vitest",
    "dev:web": "vite dev --open",
    "dev:app": "node scripts/dev/session.mjs start",
    "dev:status": "node scripts/dev/session.mjs status",
    "dev:doctor": "node scripts/dev/session.mjs doctor",
    "dev:revision": "node scripts/dev/session.mjs revision",
    "dev:wait": "node scripts/dev/session.mjs wait",
    "dev:capture": "node scripts/dev/session.mjs capture",
    "dev:stop": "node scripts/dev/session.mjs stop",
    "dev:prepare": "node scripts/dev/session.mjs prepare"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bot-avatars": "^0.1.1",
    "dashjs": "^5.2.1",
    "hls.js": "^1.7.3",
    "lottie-web": "^5.13.0",
    "marked": "^14.1.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sveltekit-i18n": "^2.4.2",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
