{
  "name": "omniget",
  "version": "0.10.1",
  "description": "Udemy, Hotmart and YouTube downloader with a yt-dlp GUI for 1,800+ sites, and a desktop app to run AI agents (Claude Code, Codex, Gemini CLI, Ollama) with permissions, undo, jobs, loops and an MCP server. Free and open source for Windows, macOS and Linux.",
  "keywords": [
    "downloader",
    "yt-dlp",
    "yt-dlp-gui",
    "youtube-downloader",
    "video-downloader",
    "udemy-downloader",
    "hotmart-downloader",
    "course-downloader",
    "instagram-downloader",
    "tiktok-downloader",
    "ai-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "ollama",
    "mcp-server",
    "agent-client-protocol",
    "coding-agent",
    "desktop-app",
    "tauri"
  ],
  "homepage": "https://github.com/tonhowtf/omniget",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonhowtf/omniget.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:appimage": "bash scripts/linux/appimage.sh",
    "version:set": "node scripts/bump-version.js",
    "generate:i18n-keys": "node scripts/generate-i18n-keys.js",
    "check:i18n": "node scripts/generate-i18n-keys.js --strict",
    "check:clippy-baseline": "node scripts/clippy-baseline.mjs --check",
    "update:clippy-baseline": "node scripts/clippy-baseline.mjs --update",
    "extension:sync": "node browser-extension/sync.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "hls.js": "^1.6.16",
    "marked": "^14.1.3",
    "sveltekit-i18n": "^2.4.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.6.0",
    "playwright": "^1.62.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
