[Desktop Entry]
Type=Application
Name=GNU Image Manipulation Program
Name[pt_BR]=Programa de Manipulação de Imagens do GNU
GenericName=Image Editor
Exec=gimp-2.10 %U
TryExec=gimp-2.10
Icon=gimp
Categories=Graphics;2DGraphics;RasterGraphics;GTK;

[Desktop Action new]
Name=Create a new image
Exec=gimp-2.10 --new
