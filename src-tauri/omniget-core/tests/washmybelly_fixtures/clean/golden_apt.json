{
  "rules": [
    {
      "action": {
        "type": "delete_contents"
      },
      "category": "apps",
      "description": "Delete the cache",
      "destination": "unlink",
      "exclude": [],
      "id": "bleachbit.apt.package_lists",
      "include": [],
      "label": "APT: Package lists",
      "label_key": null,
      "license": "GPL-3.0",
      "min_age_days": 0,
      "os": [
        "linux"
      ],
      "requires": [
        {
          "type": "admin"
        }
      ],
      "risk": "destructive",
      "running": [
        "apt-get",
        "synaptic"
      ],
      "source": "BleachBit",
      "targets": [
        "/var/lib/apt/lists"
      ]
    }
  ],
  "skipped": [
    {
      "cleaner": "apt",
      "option": "autoclean",
      "reason": "system package manager: covered by the Linux rules through the manager itself",
      "what": "apt.autoclean"
    },
    {
      "cleaner": "apt",
      "option": "autoremove",
      "reason": "system package manager: covered by the Linux rules through the manager itself",
      "what": "apt.autoremove"
    },
    {
      "cleaner": "apt",
      "option": "clean",
      "reason": "system package manager: covered by the Linux rules through the manager itself",
      "what": "apt.clean"
    }
  ]
}
