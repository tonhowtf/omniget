   },
   "group": "ours.power_plan",
   "ops": [
    {
     "op": "power_setting",
     "scheme": "balanced"
    }
   ],
   "risk": "reversible",
   "needs_restart": false,
   "source": "omniget",
   "license": "GPL-3.0"
  },
  {
   "id": "ours.power_high",
   "label": "Power plan: High performance",
   "description": "Keeps the processor at high clock speeds. Undo goes back to the plan you had.",
   "category": "gaming",
   "applies": {
    "min_build": null,
    "max_build": null
   },
   "group": "ours.power_plan",
   "ops": [
    {
     "op": "power_setting",
     "scheme": "high_performance"
    }
   ],
   "risk": "reversible",
   "needs_restart": false,
   "warning": "Uses more power and heat; on a laptop it drains the battery.",
   "source": "omniget",
   "license": "GPL-3.0"
  },
  {
   "id": "ours.power_ultimate",
   "label": "Power plan: Ultimate performance",
   "description": "Adds the Ultimate Performance plan and turns it on. Undo goes back to your plan and removes the one we added.",
   "category": "gaming",
   "applies": {
    "min_build": 17134,
    "max_build": null
   },
   "group": "ours.power_plan",
   "ops": [
    {
     "op": "power_setting",
     "scheme": "ultimate"
    }
   ],
   "risk": "reversible",
   "needs_restart": false,
   "warning": "Made for desktops; on a laptop it drains the battery.",
   "source": "winutil",
   "license": "MIT",
   "upstream": "Invoke-WPFUltimatePerformance.ps1"
  },
  {
   "id": "ours.updates_defer",
   "label": "Delay updates (security first)",
   "description": "Feature updates wait a year and quality updates four days. Security fixes keep coming; Windows Update stays on.",
   "category": "updates",
   "applies": {
    "min_build": null,
    "max_build": null,
    "editions": [
     "Professional",
     "ProfessionalN",
     "ProfessionalWorkstation",
     "ProfessionalWorkstationN",
     "ProfessionalEducation",
     "ProfessionalEducationN",
     "Enterprise",
     "EnterpriseN",
     "EnterpriseS",
     "EnterpriseSN",
     "Education",
     "EducationN",
     "IoTEnterprise",
     "IoTEnterpriseS"
    ]
   },
   "ops": [
    {
     "op": "reg_set",
     "hive": "HKLM",
     "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
     "name": "DeferFeatureUpdates",
     "kind": "REG_DWORD",
     "data": "1"
    },
    {
     "op": "reg_set",
     "hive": "HKLM",
     "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
     "name": "DeferFeatureUpdatesPeriodInDays",
     "kind": "REG_DWORD",
     "data": "365"
    },
    {
     "op": "reg_set",
     "hive": "HKLM",
     "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
     "name": "DeferQualityUpdates",
     "kind": "REG_DWORD",
     "data": "1"
    },
    {
     "op": "reg_set",
     "hive": "HKLM",
     "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
     "name": "DeferQualityUpdatesPeriodInDays",
     "kind": "REG_DWORD",
     "data": "4"
    }
   ],
   "default_ops": [
    {
     "op": "reg_delete",
     "hive": "HKLM",
     "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
     "name": "DeferFeatureUpdates"
    },
    {
     "op": "reg_delete",
     "hive": "HKLM",
     "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
     "name": "DeferFeatureUpdatesPeriodInDays"
    },
    {
     "op": "reg_delete",
     "hive": "HKLM",
     "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
     "name": "DeferQualityUpdates"
    },
    {
     "op": "reg_delete",
     "hive": "HKLM",
     "key": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
     "name": "DeferQualityUpdatesPeriodInDays"
    }
   ],
   "risk": "reversible",
   "needs_restart": false,
   "source": "winutil",
   "license": "MIT",
   "upstream": "Invoke-WPFUpdatessecurity.ps1"
  },
