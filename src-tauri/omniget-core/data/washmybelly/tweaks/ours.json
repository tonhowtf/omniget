 "groups": [
  {
   "id": "ours.power_plan",
   "label": "Power plan",
   "description": "Undo always goes back to the plan you had before.",
   "members": [
    "ours.power_balanced",
    "ours.power_high",
    "ours.power_ultimate"
   ],
   "default": "ours.power_balanced"
  }
 ],
 "items": [
  {
   "id": "ours.hvci_off",
   "label": "Turn off memory integrity (Core Isolation)",
   "description": "Memory integrity makes the kernel check every driver. Turning it off gives a few frames per second in some games.",
   "category": "gaming",
   "applies": {
    "min_build": 19041,
    "max_build": null
   },
   "ops": [
    {
     "op": "reg_set",
     "hive": "HKLM",
     "key": "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity",
     "name": "Enabled",
     "kind": "REG_DWORD",
     "data": "0"
    }
   ],
   "default_ops": [
    {
     "op": "reg_set",
     "hive": "HKLM",
     "key": "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity",
     "name": "Enabled",
     "kind": "REG_DWORD",
     "data": "1"
    }
   ],
   "risk": "extreme",
   "needs_restart": true,
   "warning": "This trades security for FPS: without memory integrity a malicious driver can take over the kernel. Turn it back on when you are done playing.",
   "source": "omniget",
   "license": "GPL-3.0"
  },
  {
   "id": "ours.power_balanced",
   "label": "Power plan: Balanced",
   "description": "The Windows default: fast when you need it, saves power when idle.",
   "category": "gaming",
   "applies": {
    "min_build": null,
