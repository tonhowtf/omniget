  {
   "id": "sophia.hags",
   "label": "Hardware-accelerated GPU scheduling",
   "description": "Lets the graphics card manage its own memory queue. Needed by frame generation on NVIDIA cards; the gain in other games varies and can be negative.",
   "category": "gaming",
   "applies": { "min_build": 19041, "max_build": null },
   "requires": ["hags"],
   "ops": [
    { "op": "reg_set", "hive": "HKLM", "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers", "name": "HwSchMode", "kind": "REG_DWORD", "data": "2" }
   ],
   "default_ops": [
    { "op": "reg_set", "hive": "HKLM", "key": "SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers", "name": "HwSchMode", "kind": "REG_DWORD", "data": "1" }
   ],
   "risk": "reversible",
   "needs_restart": true,
   "warning": "Measure your games before and after: if nothing improves, undo it.",
   "source": "sophia",
   "license": "MIT",
   "upstream": "GPUScheduling"
  },
