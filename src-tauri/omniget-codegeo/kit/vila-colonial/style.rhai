// Vila colonial: whitewashed walls over a stone plinth, terracotta clay
// roofs with wide eaves and tile ribs, green shutters and frames, cornice
// mouldings, arched doors.
fn S() {
    #{
        corner: 0.3, plinth: true, cornice: true, corner_mat: "trim",
        eave: 0.45, thick: 0.15, ribs: true, ridge_mat: "roof", parapet: 0.4, coping: true,
        arch_door: true, arch_win: true, frame_mat: "trim", shutters: true, shutter_mat: "door",
        balcony_mat: "stone", rail_mat: "metal", chimney_mat: "wall", fence_mat: "wood",
    }
}
