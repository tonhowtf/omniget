    website: "https://tonho.wtf"
repository-code: "https://github.com/tonhowtf/omniget"
url: "https://getomniget.com"
license: GPL-3.0-only
keywords:
  - mcp-server
  - model-context-protocol
  - coding-agents
  - download-manager
  - yt-dlp
  - tauri
  - rust
