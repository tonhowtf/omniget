{
 "entry": [
  "src/routes/**/+page.svelte!",
  "src/routes/**/+layout.svelte!",
  "src/routes/**/+page.ts!",
  "src/routes/**/+layout.ts!",
  "src/routes/**/+server.ts!",
  "src/hooks*.ts!",
  "src/app.html!",
  "src/app.d.ts!",
  "svelte.config.js",
  "vite.config.js",
  "vitest.config.ts",
  "src/**/*.test.ts",
  "scripts/**/*.{mjs,js}",
  "src/components/download/tools/*.tool.ts!",
  "src/components/canvas/nodes/*.svelte!"
 ],
 "project": [
  "src/**/*.{ts,js,svelte}!",
  "scripts/**/*.{mjs,js}",
  "*.{js,ts}"
 ],
 "ignore": [
  "src/lib/vendor/**",
  "browser-extension/**"
 ],
 "paths": {
  "$lib": [
   "src/lib"
  ],
  "$lib/*": [
   "src/lib/*"
  ],
  "$components": [
   "src/components"
  ],
  "$components/*": [
   "src/components/*"
  ],
  "$app/*": [
   "node_modules/@sveltejs/kit/src/runtime/app/*"
  ]
 },
 "$schema": "https://unpkg.com/knip@5/schema.json"
}